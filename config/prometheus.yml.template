# Prometheus configuration for Life App development
#
# This Prometheus instance runs as a sidecar in the dev container and:
# 1. Scrapes Django metrics from http://app:8000/metrics (internal Docker network)
# 2. Remote-writes to TrueNAS Mimir for centralized storage and visualization

global:
  scrape_interval: 30s
  scrape_timeout: 10s
  evaluation_interval: 30s
  external_labels:
    deployment: 'wsl2-devcontainer'
    cluster: 'dev'

# Scrape Django metrics locally within Docker network
scrape_configs:
  - job_name: 'life-app-backend'
    static_configs:
      - targets:
          - 'app:8000'  # Django container (internal Docker network)
        labels:
          app: 'life-app-backend'
          env: 'development'
          service: 'django'

  # Self-monitoring: Prometheus scrapes itself
  - job_name: 'prometheus'
    static_configs:
      - targets:
          - 'localhost:9090'

# Remote-write to TrueNAS Mimir
remote_write:
  - url: '${MIMIR_ENDPOINT}/api/v1/push'
    queue_config:
      capacity: 10000
      max_shards: 5
      min_shards: 1
      max_samples_per_send: 5000
      batch_send_deadline: 5s
      min_backoff: 30ms
      max_backoff: 100ms
    metadata_config:
      send: true
      send_interval: 1m
